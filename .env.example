# ==============================================================================
# SMARTCONTACTS — ARCHIVO DE EJEMPLO Y DOCUMENTACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Este archivo documenta todas las variables de entorno utilizadas en el proyecto,
# indicando su ubicación exacta en el código, su propósito funcional y sus valores sintácticos.
# 
# REGLA 6 (.agents/AGENTS.md):
# - Queda estrictamente prohibido utilizar credenciales quemadas en el código fuente.
# - Toda variable debe registrarse aquí con contexto completo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE BASE URL
# ------------------------------------------------------------------------------
# Dónde se usa:
#   - lib/blocked-domains.ts
#   - app/api/booking/route.ts (Guardado en calendario.prospectos)
#   - app/api/check-domain/route.ts (Proxy a Edge Function)
# Propósito:
#   URL base HTTPS del proyecto Supabase para ejecutar consultas a la API REST de PostgreSQL.
# 
NEXT_PUBLIC_SUPABASE_URL=https://fxhemyrjetpwtmjxmftk.supabase.co


# ------------------------------------------------------------------------------
# 2. SUPABASE ANON API KEY
# ------------------------------------------------------------------------------
# Dónde se usa:
#   - lib/blocked-domains.ts
#   - app/api/booking/route.ts
# Propósito:
#   Llave pública anónima (anon key) de Supabase enviada en las cabeceras `apikey` y `Authorization`
#   para consultar la lista de dominios bloqueados y guardar agendamientos de prospectos.
# 
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ------------------------------------------------------------------------------
# 3. SUPABASE EDGE FUNCTION URL (OPCIONAL EN SERVIDOR)
# ------------------------------------------------------------------------------
# Dónde se usa:
#   - app/api/check-domain/route.ts
# Propósito:
#   Sobrescribe la ruta pública del endpoint Edge Function check-domain.
#   Si no se especifica, el proxy construye dinámicamente: ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1/check-domain
# 
SUPABASE_EDGE_URL=https://fxhemyrjetpwtmjxmftk.supabase.co/functions/v1/check-domain


# ------------------------------------------------------------------------------
# 4. INTERNAL EDGE FUNCTION SECRET HEADER
# ------------------------------------------------------------------------------
# Dónde se usa:
#   - app/api/check-domain/route.ts
#   - Supabase Edge Function `check-domain` (Deno Edge Runtime)
# Propósito:
#   Token de seguridad privado de cabecera `x-app-secret`. Autentica al servidor Next.js
#   ante la Edge Function de Supabase para prevenir peticiones maliciosas directas desde internet.
# 
CHECK_DOMAIN_SECRET=smartcontacts-internal-edge-secret-2026


# ------------------------------------------------------------------------------
# 5. N8N WORKFLOW WEBHOOK URL (OPCIONAL)
# ------------------------------------------------------------------------------
# Dónde se usa:
#   - app/api/booking/route.ts
# Propósito:
#   Webhook receptor en el servidor ventus (ventusn8n.smartcontacts.cloud)
#   que desencadena automatizaciones comerciales y notificaciones de WhatsApp/Email.
# 
N8N_WEBHOOK_URL=https://ventusn8n.smartcontacts.cloud/webhook/smartcontacts-booking
