# ==============================================================================
# SmartContacts — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copie este archivo a .env.local para el desarrollo local o configure cada una
# de estas variables en la consola de producción (Dokploy / smartcontacts.cloud).
# No incluya secretos reales o llaves privadas directamente en este archivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (PostgreSQL, Auth & PostgREST API)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL:
#   - Archivos: lib/infrastructure/repositories/*, components/ui/*
#   - Propósito: URL HTTPS del proyecto Supabase para consumo de APIs y Base de Datos.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY:
#   - Archivos: Inicialización de createClient() en cliente y servidor.
#   - Propósito: Llave anónima pública con políticas de Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# CHECK_DOMAIN_SECRET:
#   - Archivos: app/api/booking/route.ts, use-cases/process-booking-use-case.ts
#   - Propósito: Secreto de verificación para peticiones de validación de dominios corporativos.
CHECK_DOMAIN_SECRET=your-check-domain-secret-token

# ------------------------------------------------------------------------------
# 2. Sistema de Referidos & Recompensas (referidos.*)
# ------------------------------------------------------------------------------
# REFERRAL_COOKIE_EXPIRATION_DAYS:
#   - Archivos: middleware.ts, app/api/referrals/track/route.ts
#   - Propósito: Días de expiración de la cookie 'sc_ref_token' para atribución First-Touch.
REFERRAL_COOKIE_EXPIRATION_DAYS=45

# REFERRAL_GUARANTEE_WINDOW_DAYS:
#   - Archivos: app/api/referrals/conversions/route.ts
#   - Propósito: Días de enfriamiento antes de liberar la comisión a estado liquidable.
REFERRAL_GUARANTEE_WINDOW_DAYS=10

# ------------------------------------------------------------------------------
# 3. Gmail OAuth2 (Confirmación de citas y correos transaccionales)
# ------------------------------------------------------------------------------
# GMAIL_SENDER_EMAIL:
#   - Archivos: lib/infrastructure/services/gmail-email-service.ts
#   - Propósito: Correo remitente verificado para envíos de confirmación.
GMAIL_SENDER_EMAIL=tu-correo@empresa.com

# GMAIL_SENDER_NAME:
#   - Archivos: lib/infrastructure/services/gmail-email-service.ts
#   - Propósito: Nombre público visible en el remitente del correo.
GMAIL_SENDER_NAME=Agendamiento Smartcontacts

# GMAIL_CLIENT_ID & GMAIL_CLIENT_SECRET:
#   - Archivos: lib/infrastructure/services/gmail-email-service.ts
#   - Propósito: Credenciales de la aplicación cliente registradas en Google Cloud Console.
GMAIL_CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-google-oauth2-client-secret

# GMAIL_REFRESH_TOKEN:
#   - Archivos: lib/infrastructure/services/gmail-email-service.ts
#   - Propósito: Token de actualización OAuth2 para autorizar el envío continuo sin login interactivo.
GMAIL_REFRESH_TOKEN=1//05your-google-oauth2-refresh-token

# ------------------------------------------------------------------------------
# 4. Webhooks de Automatización & Integraciones (n8n & Platzi)
# ------------------------------------------------------------------------------
# PLATZI_WEBHOOK_URL:
#   - Archivos: app/api/booking/route.ts
#   - Propósito: URL del webhook n8n para el pipeline de prospección externa.
PLATZI_WEBHOOK_URL=https://ventusn8n.smartcontacts.cloud/webhook/Paltzi

# PLATZI_WEBHOOK_KEY / x-api-key / X_API_KEY:
#   - Archivos: Headers HTTP hacia n8n y endpoints de integración.
#   - Propósito: Llave de autorización para invocación de webhooks seguros.
PLATZI_WEBHOOK_KEY=your-jwt-or-api-key
x-api-key=your-jwt-or-api-key
X_API_KEY=your-jwt-or-api-key

PLATZI_JWT_SECRET=your-secret-key-prod

# ------------------------------------------------------------------------------
# 5. Supabase Auto-Hospedado / BD Pesada de Email Marketing (emailmarketing.*)
# ------------------------------------------------------------------------------
# EMAIL_SUPABASE_URL:
#   - Archivos: lib/infrastructure/supabase/supabase-client.ts, app/api/email/*
#   - Propósito: Endpoint de la base de datos pesada con directorios masivos (+200k/4M contactos)
#                y lista negra de 119.9k dominios.
EMAIL_SUPABASE_URL=https://your-selfhosted-supabase-ref.supabase.co

# EMAIL_SUPABASE_ANON_KEY:
#   - Archivos: lib/infrastructure/supabase/supabase-client.ts, app/api/email/*
#   - Propósito: Clave anónima pública del proyecto pesado de marketing.
EMAIL_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 6. Multi-Cuentas de Gmail / Balanceo de Envíos (Opcional)
# ------------------------------------------------------------------------------
# GMAIL_ACCOUNTS_JSON:
#   - Archivos: lib/gmail-accounts-manager.ts, app/api/email/accounts/route.ts
#   - Propósito: Arreglo JSON con cuentas remitentes adicionales para rotar APIs de Gmail,
#                superar límites diarios de 500 correos y clasificar por tipo (ventas, soporte, etc.).
#   - Formato: [{"id":"ventas-2","email":"ventas2@dominio.com","name":"Ventas","clientId":"...","clientSecret":"...","refreshToken":"...","dailyLimit":450}]
GMAIL_ACCOUNTS_JSON=[]

# ------------------------------------------------------------------------------
# 7. Google Sheets API v4 (Almacenamiento en vivo de Citas & Leads)
# ------------------------------------------------------------------------------
# GOOGLE_SPREADSHEET_ID:
#   - Archivos: lib/infrastructure/sheets/google-sheets-service.ts, lib/use-cases/process-booking-use-case.ts
#   - Propósito: ID oficial de la hoja de cálculo de Google Sheets donde se registran
#                automáticamente todas las citas agendadas y prospectos comerciales.
#                Si no se especifica, el servicio inicializa una nueva hoja automáticamente
#                titulada "Smartcontacts — Registro Oficial de Citas & Leads".
#   - Ejemplo: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id
# ------------------------------------------------------------------------------
# 8. Seguridad, Autenticación y Roles (Supabase Auth & RBAC)
# ------------------------------------------------------------------------------
# La autenticación utiliza el suite oficial de Supabase Auth en conjunto con el esquema
# `seguridad.perfiles` y cookies de sesión administradas por `@supabase/ssr`.
#
# SUPER ADMIN INICIAL:
#   - Correo registrado automáticamente con rol 'super_admin':
#     jesus.carmona966@pascualbravo.edu.co
#   - Roles soportados: 'super_admin' (gobernanza total), 'admin' (operación), 'user' (estándar).
#   - Políticas de seguridad: RLS activo en esquema `seguridad.*` y Rate Limiting anti-fuerza bruta.
# ------------------------------------------------------------------------------
